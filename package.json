{
  "name": "execej",
  "productName": "EXECEJ",
  "version": "1.0.1",
  "description": "Aplicativo gerado por App Packager Studio",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win nsis"
  },
  "dependencies": {
    "adm-zip": "^0.5.18",
    "electron-log": "^5.4.4",
    "electron-updater": "^6.8.9",
    "pdf-lib": "^1.17.1",
    "pdf-parse": "^2.4.5"
  },
  "build": {
    "appId": "com.app.execej",
    "productName": "EXECEJ",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "devDependencies": {
    "electron": "^32.3.3",
    "electron-builder": "^26.15.3"
  },
  "allowScripts": {
    "electron@32.3.3": true,
    "electron-winstaller": true
  }
}
